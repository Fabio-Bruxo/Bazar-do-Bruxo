# ==========================================
# O BAZAR DO BRUXO - VARIÁVEIS DE AMBIENTE
# ==========================================

# APLICAÇÃO & SERVIÇO
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
SESSION_SECRET=bazar_secreto_super_seguro_para_sessoes_2026_mistic
ENCRYPTION_KEY=bazar_chave_criptografia_aes_256_bit_segura_2026
# JWT interno do Bazar (sessions de usuário) — substitua por string aleatória longa em produção
JWT_SECRET=bazar_jwt_secreto_super_seguro_troque_em_producao_2026

# GOOGLE OAUTH 2.0
# Crie as credenciais em: https://console.cloud.google.com → APIs & Services → Credentials
# Tipo: Aplicativo da Web
# URIs de redirecionamento autorizados: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BANCO DE DADOS & SUPABASE (@supabase/server)
DATABASE_URL=postgresql://bazar_user:bazar_pass_2026@localhost:5432/bazar_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# URL do projeto Supabase
SUPABASE_URL=https://llnpckqjphhwlplrgpdu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://llnpckqjphhwlplrgpdu.supabase.co
# Chave pública (client-side safe)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NAtMS6AEwR0nqDyLZ1JXow_8-4MO-MC
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NAtMS6AEwR0nqDyLZ1JXow_8-4MO-MC
# Chave secreta (NUNCA no front-end — apenas server/API routes)
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_PELA_CHAVE_REAL
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA_PELA_CHAVE_REAL
# JWKS para validação de tokens JWT do Supabase Auth
SUPABASE_JWKS_URL=https://llnpckqjphhwlplrgpdu.supabase.co/auth/v1/.well-known/jwks.json

# REDIS (Filas e Cache)
REDIS_URL=redis://localhost:6379

# INTELIGÊNCIA ARTIFICIAL (Modo Offline / Sem IA Paga)
AI_ENABLED=false

# PAGAMENTO (Mercado Pago & Split Marketplace)
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_CLIENT_ID=0000000000000000
MERCADOPAGO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=bazar_mp_webhook_secret_validacao_assinatura
