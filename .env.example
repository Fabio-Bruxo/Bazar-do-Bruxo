ENCRYPTION_KEY=bazar_chave_criptografia_aes_256_bit_segura_2026

# BANCO DE DADOS & SUPABASE
DATABASE_URL=postgresql://bazar_user:bazar_pass_2026@localhost:5432/bazar_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# REDIS (Filas e Cache)
REDIS_URL=redis://localhost:6379

# INTELIGÊNCIA ARTIFICIAL (Modo Offline / Sem IA Paga)
