    {
      "parameters": {
        "functionCode": "// Compila faturamento bruto, margem líquida do Bazar, pedidos despachados e envia ao e-mail administrativo.\nreturn items.map(item => ({\n  json: {\n    workflow: '11 - Relatório Financeiro e Operacional Diário',\n    status: 'SUCCESS',\n    timestamp: new Date().toISOString(),\n    data: item.json\n  }\n}));"
      },
